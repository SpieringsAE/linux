/dts-v1/;
#include "jh7110-common.dtsi"
#include <dt-bindings/pwm/pwm.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	model = "DeepComputing FML13V01";
	compatible = "deepcomputing,fml13v01", "starfive,jh7110";

	backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm0 0 5000000 PWM_POLARITY_INVERTED>;

		brightness-levels = <0 255>;
		default-brightness-level = <127>;
		num-interpolated-steps = <255>;
	};

	sound-es8326 {
		compatible = "simple-audio-card";
		simple-audio-card,aux-devs = <&speaker_amp>;
		simple-audio-card,name = "FML13V01-ES8326-Sound-Card";
		simple-audio-card,format = "i2s";
		simple-audio-card,bitclock-master = <&dailink0_master>;
		simple-audio-card,frame-master = <&dailink0_master>;
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,widgets =
			"Microphone", "Builtin Microphone",
			"Microphone", "Headset Microphone",
			"Headphone", "Headphones",
			"Speaker", "Builtin Speaker";
		simple-audio-card,routing =
			"MIC1", "Headset Microphone",
			"MIC2", "Builtin Microphone",
			"Headphones", "HPOL",
			"Headphones", "HPOR",
			"Builtin Speaker", "Speaker Amp OUTR",
			"Builtin Speaker", "Speaker Amp OUTL",
			"Speaker Amp INR", "HPOR",
			"Speaker Amp INL", "HPOL";

		simple-audio-card,cpu0 {
			sound-dai = <&i2stx1>;
		};

		simple-audio-card,cpu1 {
			sound-dai = <&i2srx>;
		};

		dailink0_master: simple-audio-card,codec {
			sound-dai = <&es8326>;
		};
	};

	speaker_amp: speaker-amp {
		compatible = "simple-audio-amplifier";
		// pinctrl-0 = <&spkamp_pins>;
		// pinctrl-names = "default";
		sound-name-prefix = "Speaker Amp";
		enable-gpios = <&sysgpio 49 GPIO_ACTIVE_HIGH>;
	};
};

&i2c2 {
	clock-frequency = <400000>;
	pinctrl-0 = <&i2c2_pins>;
	pinctrl-names = "default";

	es8326: audio-codec@19 {
		compatible = "everest,es8326";
		reg = <0x19>;
		interrupts-extended = <&sysgpio 46 IRQ_TYPE_EDGE_RISING>;
		pinctrl-0 = <&es8326_pins>;
		pinctrl-names = "default";
		#sound-dai-cells = <0>;
		// everest,jack-detect-inverted;
		everest,jack-pol = [0e];
		everest,mic1-src = [00];
		everest,mic2-src = [44];
		everest,interrupt-src = [08];
		everest,interrupt-clk = [45];
	};
};

&i2c6 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c6_pins>;
	status = "okay";

	touchpad: hid@2c {
		compatible = "hid-over-i2c";
		reg = <0x2c>;
		hid-descr-addr = <0x0020>;
		interrupts-extended = <&sysgpio 30 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-0 = <&i2c_hid_pins>;
		pinctrl-names = "default";
	};
};

&i2srx {
	pinctrl-names = "default";
	pinctrl-0 = <&i2srx_pins>;
	status = "okay";
};

&i2stx1 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2stx1_pins>;
	status = "okay";
};

&mmc0 {
	cap-mmc-highspeed;
	cap-mmc-hw-reset;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	vmmc-supply = <&vcc_3v3>;
	vqmmc-supply = <&emmc_vdd>;
};

&mmc0_pins {
	 rst-pins {
		pinmux = <GPIOMUX(62, GPOUT_SYS_SDIO0_RST,
				      GPOEN_ENABLE,
				      GPI_NONE)>;
		bias-pull-up;
		drive-strength = <12>;
		input-disable;
		input-schmitt-disable;
		slew-rate = <0>;
	};
};

&mmc1 {
	cd-gpios = <&sysgpio 41 GPIO_ACTIVE_LOW>;
	disable-wp;
};

&pcie1 {
	perst-gpios = <&sysgpio 21 GPIO_ACTIVE_LOW>;
	phys = <&pciephy1>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie1_pins>;
	status = "okay";
};

&pwm0 {
	status = "okay";
};

&pwm0_pins {
	pwm0-pins {
		pinmux = <GPIOMUX(22, GPOUT_SYS_PWM_CHANNEL0,
				      GPOEN_SYS_PWM0_CHANNEL0,
				      GPI_NONE)>;
		bias-disable;
		drive-strength = <12>;
		input-disable;
		input-schmitt-disable;
		slew-rate = <0>;
	};
};

&pwmdac_codec {
	status = "disabled";
};

&{/sound} {
	status = "disabled";
};

&sysgpio {
	es8326_pins: es8326-0 {
		irq-pins {
			pinmux = <GPIOMUX(46, GPOUT_LOW,
					      GPOEN_DISABLE,
					      GPI_NONE)>;
			input-enable;
		};
	};

	i2c_hid_pins: i2c-hid-0 {
		irq-pins {
			pinmux = <GPIOMUX(30, GPOUT_LOW,
					      GPOEN_DISABLE,
					      GPI_NONE)>;
			input-enable;
		};
	};

	i2srx_pins: i2srx-0 {
		clk-sd-pins {
			pinmux = <GPIOMUX(38, GPOUT_LOW,
					      GPOEN_DISABLE,
					      GPI_SYS_I2SRX_BCLK)>,
				 <GPIOMUX(63, GPOUT_LOW,
					      GPOEN_DISABLE,
					      GPI_SYS_I2SRX_LRCK)>,
				 <GPIOMUX(38, GPOUT_LOW,
					      GPOEN_DISABLE,
					      GPI_SYS_I2STX1_BCLK)>,
				 <GPIOMUX(63, GPOUT_LOW,
					      GPOEN_DISABLE,
					      GPI_SYS_I2STX1_LRCK)>,
				 <GPIOMUX(44, GPOUT_LOW,
					      GPOEN_DISABLE,
					      GPI_SYS_I2SRX_SDIN0)>;
			input-enable;
		};
	};

	i2stx1_pins: i2stx1-0 {
		sd-pins {
			pinmux = <GPIOMUX(61, GPOUT_SYS_I2STX1_SDO0,
					      GPOEN_ENABLE,
					      GPI_NONE)>;
			bias-disable;
			input-disable;
		};
	};

	pcie1_pins: pcie1-0 {
		clkreq-pins {
			pinmux = <GPIOMUX(29, GPOUT_LOW,
					      GPOEN_DISABLE,
					      GPI_NONE)>;
			bias-pull-down;
			drive-strength = <2>;
			input-enable;
			input-schmitt-disable;
			slew-rate = <0>;
		};

		wake-pins {
			pinmux = <GPIOMUX(28, GPOUT_HIGH,
					      GPOEN_DISABLE,
					      GPI_NONE)>;
			bias-pull-up;
			drive-strength = <2>;
			input-enable;
			input-schmitt-disable;
			slew-rate = <0>;
		};
	};

	// spkamp_pins: spkamp-0 {
	// 	enable-pins {
	// 		pinmux = <GPIOMUX(49, GPOUT_HIGH,
	// 				      GPOEN_ENABLE,
	// 				      GPI_NONE)>;
	// 		bias-disable;
	// 		input-disable;
	// 		input-schmitt-disable;
	// 		slew-rate = <0>;
	// 	};
	// };

	usb0_pins: usb0-0 {
		vbus-pins {
			pinmux = <GPIOMUX(25,  GPOUT_SYS_USB_DRIVE_VBUS,
					       GPOEN_ENABLE,
					       GPI_NONE)>;
			bias-disable;
			input-disable;
			input-schmitt-disable;
			slew-rate = <0>;
		};
	};
};

&usb0 {
	dr_mode = "host";
	pinctrl-names = "default";
	pinctrl-0 = <&usb0_pins>;
	status = "okay";
};

&usb_cdns3 {
	phys = <&usbphy0>, <&pciephy0>;
	phy-names = "cdns3,usb2-phy", "cdns3,usb3-phy";
};
